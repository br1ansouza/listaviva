{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "listaviva",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/wake"]
  },
  "ratelimits": [
    { "name": "WAKE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "WAKE_LIMIT_GLOBAL", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "API_HEALTH_URL": "https://listaviva-api.onrender.com/up",
    "RENDER_SERVICE_ID": "srv-daeo5g0n74is73eo49p0"
  }
}
